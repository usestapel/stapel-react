{
  "name": "@stapel/docs-react",
  "version": "0.7.0",
  "description": "Headless React flow pair for stapel-docs: typed API client, TanStack Query hooks, snapshot-save discipline (If-Match head_seq), the editor_hint registry (registerDocEditor), headless components (documents / folder tree / editor / revisions / trash / upload / media / sharing), and i18n keys. Zero visual opinion in the main entry; an opt-in /default subpath ships the self-themed antd skin (file manager, context menus, revision modal, editors) — every part swappable via the skin slot registry. Real editing engines live behind their own subpaths as OPTIONAL peers loaded with import(): /editors/codemirror (byte-stable source editing) and /editors/milkdown (markdown WYSIWYG with a source mode), so no editor engine is ever in the main entry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usestapel/stapel-react.git",
    "directory": "packages/docs-react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./default": {
      "types": "./dist/default/index.d.ts",
      "default": "./dist/default/index.js"
    },
    "./editors/codemirror": {
      "types": "./dist/editors/codemirror/index.d.ts",
      "default": "./dist/editors/codemirror/index.js"
    },
    "./editors/collab": {
      "types": "./dist/editors/collab/index.d.ts",
      "default": "./dist/editors/collab/index.js"
    },
    "./editors/milkdown": {
      "types": "./dist/editors/milkdown/index.d.ts",
      "default": "./dist/editors/milkdown/index.js"
    },
    "./i18n/ru": {
      "types": "./dist/i18n/ru.d.ts",
      "default": "./dist/i18n/ru.js"
    },
    "./i18n/es": {
      "types": "./dist/i18n/es.d.ts",
      "default": "./dist/i18n/es.js"
    },
    "./nav-manifest": "./nav-manifest.json",
    "./nav-manifest.json": "./nav-manifest.json",
    "./manifest": "./manifest.json",
    "./manifest.json": "./manifest.json",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "manifest.json",
    "nav-manifest.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && vitest run --exclude test/prodBundlePurity.test.ts",
    "test:pack": "vitest run test/prodBundlePurity.test.ts",
    "lint": "eslint .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "index — headless docs pair (client + hooks + editor registry + builtins + i18n)",
      "path": "dist/index.js",
      "limit": "12 KB"
    },
    {
      "name": "default — the file-manager/editor skin (antd) must stay out of the main bundle",
      "path": "dist/default/index.js",
      "limit": "22 KB"
    },
    {
      "name": "editors/codemirror — the lazy engine's WRAPPER only (plus the pair's key table): CodeMirror itself is a dynamic import() and must never be measured here",
      "path": "dist/editors/codemirror/index.js",
      "limit": "6 KB"
    },
    {
      "name": "editors/milkdown — the lazy engine's WRAPPER only (plus the CodeMirror source mode it falls back to): @milkdown/crepe is a dynamic import() and must never be measured here",
      "path": "dist/editors/milkdown/index.js",
      "limit": "7 KB"
    },
    {
      "name": "editors/collab — the co-editing WRAPPER only (session manager + registration): yjs and y-codemirror.next are dynamic import()s and must never be measured here",
      "path": "dist/editors/collab/index.js",
      "limit": "9 KB"
    }
  ],
  "peerDependencies": {
    "@codemirror/lang-markdown": ">=6 <7",
    "@codemirror/state": ">=6 <7",
    "@codemirror/view": ">=6 <7",
    "@milkdown/crepe": ">=7.10 <8",
    "@stapel/core": ">=0.18.1 <1.0.0",
    "@stapel/realtime": ">=0.1.1",
    "@stapel/tokens-antd": ">=0.7.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": ">=5.20.0 <7",
    "react": ">=19",
    "y-codemirror.next": ">=0.3 <0.4",
    "yjs": ">=13.6 <14"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@stapel/core": "workspace:^",
    "@stapel/realtime": "workspace:^",
    "@stapel/showcase": "workspace:^",
    "@stapel/tokens": "workspace:^",
    "@stapel/tokens-antd": "workspace:^",
    "@tanstack/react-query": "^5.81.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "antd": "^6.5.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "y-codemirror.next": "^0.3.5",
    "yjs": "^13.6.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@milkdown/crepe": {
      "optional": true
    },
    "@stapel/tokens-antd": {
      "optional": true
    },
    "antd": {
      "optional": true
    },
    "y-codemirror.next": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  }
}
