  "demos": [
    {
      "id": "chat.conversation-list-panel",
      "title": "Inbox (default skin)",
      "description": "The shipped inbox: threads newest-first, an unread count that carries its own accessible sentence rather than a hover, and a load-more control that becomes a stated end. The failed arm owns the failure on its own — an outage can never render here as `No conversations yet`.",
      "component": "ConversationListPanel",
      "covers": [
        "CounterpartyAvatar"
      ],
      "tokens": [
        "surface-raised",
        "text",
        "text-muted",
        "border-subtle"
