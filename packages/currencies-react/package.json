{
  "name": "@stapel/currencies-react",
  "version": "0.4.0",
  "description": "React pair for stapel-currencies: the Money layer of the fleet. One formatter (Intl.NumberFormat, per locale, per currency's minor units), one converter (decimal-string BigInt math in parity with the backend's services.convert), and an opt-in /default antd skin — <Price> with its estimate, a CurrencyPicker that is a bottom sheet on a phone, a decimal-string CurrencyField and a RateTable. Prices stop being `${amount} ${code}`.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usestapel/stapel-react.git",
    "directory": "packages/currencies-react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./default": {
      "types": "./dist/default/index.d.ts",
      "default": "./dist/default/index.js"
    },
    "./i18n/ru": {
      "types": "./dist/i18n/ru.d.ts",
      "default": "./dist/i18n/ru.js"
    },
    "./i18n/es": {
      "types": "./dist/i18n/es.d.ts",
      "default": "./dist/i18n/es.js"
    },
    "./manifest": "./manifest.json",
    "./manifest.json": "./manifest.json",
    "./nav-manifest.json": "./nav-manifest.json",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "MODULE.md",
    "CHANGELOG.md",
    "manifest.json",
    "nav-manifest.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.demo.json && vitest run --exclude test/prodBundlePurity.test.ts",
    "lint": "eslint .",
    "size": "size-limit",
    "test:pack": "vitest run test/prodBundlePurity.test.ts"
  },
  "size-limit": [
    {
      "name": "index — the Money layer and the hooks: no antd, no locale bundles",
      "path": "dist/index.js",
      "limit": "9 KB"
    },
    {
      "name": "default skin subpath (opt-in: antd + the token bridge)",
      "path": "dist/default/index.js",
      "limit": "10 KB"
    },
    {
      "name": "i18n/ru subpath (opt-in locale: en floor + ru UI)",
      "path": "dist/i18n/ru.js",
      "limit": "8 KB"
    },
    {
      "name": "i18n/es subpath (opt-in locale: en floor + es UI)",
      "path": "dist/i18n/es.js",
      "limit": "8 KB"
    }
  ],
  "peerDependencies": {
    "@stapel/core": ">=0.18.1 <1.0.0",
    "@stapel/tokens-antd": ">=0.7.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": ">=6.0.0 <7",
    "react": ">=19"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@stapel/core": "workspace:^",
    "@stapel/showcase": "workspace:^",
    "@stapel/tokens": "workspace:^",
    "@stapel/tokens-antd": "workspace:^",
    "@tanstack/react-query": "^5.81.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "antd": "^6.5.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@stapel/tokens-antd": {
      "optional": true
    },
    "antd": {
      "optional": true
    }
  }
}
