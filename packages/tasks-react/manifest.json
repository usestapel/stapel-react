      "id": "tasks.board-create-sheet",
      "title": "Board create sheet (default skin)",
      "description": "Name plus a shape: the preset list is the server's own vocabulary, and 'custom columns' switches to an explicit column editor whose keys are slugged from the names.",
      "component": "BoardCreateSheet",
      "variants": [
        "default",
        "phone",
        "scope-blocked"
      ],
      "source": "demo/BoardCreateSheet.demo.tsx"
    },
    {
      "id": "tasks.boards-pane",
      "title": "Boards (default skin)",
      "description": "The boards list: name, column count, creation date, an archive confirm that is a bottom sheet on a phone, and a create sheet that discovers its presets from the server.",
      "component": "BoardsPane",
      "variants": [
        "default",
        "phone",
        "empty",
        "failed",
        "no-navigation"
      ],
      "source": "demo/BoardsPane.demo.tsx"
    },
    {
      "id": "tasks.column-manager",
      "title": "Column manager (default skin)",
      "description": "Drag the columns into order (keyboard sensor included) and add one. Renaming and deleting are not in this API, so the screen explains their absence instead of drawing two controls that cannot work.",
      "component": "ColumnManager",
      "variants": [
        "default",
        "phone",
        "duplicate"
      ],
      "source": "demo/ColumnManager.demo.tsx"
    },
    {
      "id": "tasks.headless",
      "title": "Tasks headless bags",
      "description": "The renderless layer: TasksProvider wires the runtime, BoardView hands over the assembled board (columns, cards, the move machine's step) and TaskView hands over one card with its canEdit gate. No visual opinion at all.",
      "component": "TasksProvider",
      "covers": [
        "BoardView",
        "TaskView"
      ],
      "tokens": [
        "surface-raised"
      ],
      "variants": [
        "default",
        "phone"
      ],
      "source": "demo/Tasks.demo.tsx"
    },
    {
      "id": "tasks.kanban-board",
      "title": "Kanban board (default skin)",
      "description": "Columns with WIP counters, cards carrying priority, due date, checklist progress and a blocked glyph, dnd-kit drag with keyboard and touch sensors, and an optimistic move that rolls itself back on a refusal.",
      "component": "KanbanBoard",
      "variants": [
        "default",
        "phone",
        "empty",
        "truncated"
      ],
      "source": "demo/KanbanBoard.demo.tsx"
    },
    {
      "id": "tasks.task-sheet",
      "title": "Task sheet (default skin)",
      "description": "One card: title and description saved on blur, column/priority/due controls, assignees through the host seam, a checklist with a three-state overflow menu, and comments where Enter sends and Shift+Enter breaks a line.",
      "component": "TaskSheet",
      "variants": [
        "default",
        "phone",
        "archived",
        "features"
      ],
      "source": "demo/TaskSheet.demo.tsx"
    }
  ],
