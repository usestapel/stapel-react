{
  "name": "@stapel/tasks-react",
  "version": "0.1.0",
  "description": "React pair for stapel-tasks: typed API client, TanStack Query hooks, the board assembly and move state machine, headless bags, i18n keys, and an opt-in AntD kanban skin (dnd-kit drag with keyboard and touch sensors) behind the /default subpath.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usestapel/stapel-react.git",
    "directory": "packages/tasks-react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./default": {
      "types": "./dist/default/index.d.ts",
      "default": "./dist/default/index.js"
    },
    "./i18n/ru": {
      "types": "./dist/i18n/ru.d.ts",
      "default": "./dist/i18n/ru.js"
    },
    "./i18n/es": {
      "types": "./dist/i18n/es.d.ts",
      "default": "./dist/i18n/es.js"
    },
    "./manifest": "./manifest.json",
    "./manifest.json": "./manifest.json",
    "./nav-manifest.json": "./nav-manifest.json",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "MODULE.md",
    "CHANGELOG.md",
    "manifest.json",
    "nav-manifest.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.demo.json && vitest run",
    "lint": "eslint .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "index — the skin and the ru/es locales must NOT be in the main bundle",
      "path": "dist/index.js",
      "limit": "12 KB"
    },
    {
      "name": "default skin subpath (opt-in: antd + the token bridge). @dnd-kit is ignored: it is the board's drag engine, declared here so a host gets it automatically, and measuring a vendored engine as this pair's own weight would report a number no change to this package can move.",
      "path": "dist/default/index.js",
      "limit": "20 KB",
      "ignore": [
        "@dnd-kit/core",
        "@dnd-kit/sortable",
        "@dnd-kit/utilities"
      ]
    },
    {
      "name": "i18n/ru subpath (opt-in locale: en floor + ru UI)",
      "path": "dist/i18n/ru.js",
      "limit": "8 KB"
    },
    {
      "name": "i18n/es subpath (opt-in locale: en floor + es UI)",
      "path": "dist/i18n/es.js",
      "limit": "8 KB"
    }
  ],
  "peerDependencies": {
    "@stapel/core": ">=0.18.0 <1.0.0",
    "@stapel/tokens": ">=0.5.0",
    "@stapel/tokens-antd": ">=0.6.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": ">=5.20.0 <7",
    "react": ">=19"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@stapel/core": "workspace:^",
    "@stapel/showcase": "workspace:^",
    "@stapel/tokens": "workspace:^",
    "@stapel/tokens-antd": "workspace:^",
    "@tanstack/react-query": "^5.81.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "antd": "^6.5.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2"
  },
  "peerDependenciesMeta": {
    "@stapel/tokens": {
      "optional": true
    },
    "@stapel/tokens-antd": {
      "optional": true
    },
    "antd": {
      "optional": true
    }
  }
}
