{
  "name": "@stapel/moderation-react",
  "version": "0.1.0",
  "description": "Headless React flow pair for stapel-moderation: typed API client, TanStack Query hooks, flow machines, headless components, and i18n keys. Zero visual opinion.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usestapel/stapel-react.git",
    "directory": "packages/moderation-react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./default": {
      "types": "./dist/default/index.d.ts",
      "default": "./dist/default/index.js"
    },
    "./default/admin": {
      "types": "./dist/default/admin/index.d.ts",
      "default": "./dist/default/admin/index.js"
    },
    "./i18n/ru": {
      "types": "./dist/i18n/ru.d.ts",
      "default": "./dist/i18n/ru.js"
    },
    "./i18n/es": {
      "types": "./dist/i18n/es.d.ts",
      "default": "./dist/i18n/es.js"
    },
    "./manifest": "./manifest.json",
    "./manifest.json": "./manifest.json",
    "./nav-manifest.json": "./nav-manifest.json",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json",
    "./nav-manifest": "./nav-manifest.json"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "MODULE.md",
    "CHANGELOG.md",
    "manifest.json",
    "nav-manifest.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.demo.json && vitest run --exclude test/prodBundlePurity.test.ts",
    "lint": "eslint .",
    "size": "size-limit",
    "test:pack": "vitest run test/prodBundlePurity.test.ts"
  },
  "size-limit": [
    {
      "name": "index — the headless pair (18 operations, the bags and their gates): no antd",
      "path": "dist/index.js",
      "limit": "14 KB"
    },
    {
      "name": "default — the member-facing skin (report button + sheet, appeals, the public policy page)",
      "path": "dist/default/index.js",
      "limit": "14 KB"
    },
    {
      "name": "default/admin — the console must not ride in a storefront's bundle",
      "path": "dist/default/admin/index.js",
      "limit": "18 KB"
    },
    {
      "name": "i18n/ru — 271 hand-written keys plus the 70-code backend catalogue; opt-in",
      "path": "dist/i18n/ru.js",
      "limit": "12 KB"
    },
    {
      "name": "i18n/es — same deal for Spanish: a host pays for the locales it ships",
      "path": "dist/i18n/es.js",
      "limit": "10 KB"
    }
  ],
  "peerDependencies": {
    "@stapel/core": ">=0.18.0 <1.0.0",
    "@stapel/tokens-antd": ">=0.6.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": ">=5.20.0 <7",
    "react": ">=19"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@stapel/core": "workspace:^",
    "@stapel/showcase": "workspace:^",
    "@stapel/tokens": "workspace:^",
    "@stapel/tokens-antd": "workspace:^",
    "@tanstack/react-query": "^5.81.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "antd": "^6.5.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
