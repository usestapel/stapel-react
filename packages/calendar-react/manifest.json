    },
    {
      "id": "calendar.event-sheet",
      "title": "Event",
      "description": "The detail sheet: a bottom sheet on a phone, a centred modal above the tablet breakpoint, with owner-only controls switched off WITH their reason instead of hidden. `viewerId` is the host's to supply — when it is absent the sheet says it cannot tell whose event this is rather than guessing either way.",
      "component": "EventSheet",
      "covers": [
        "EventDetail"
      ],
      "tokens": [
        "surface-raised",
