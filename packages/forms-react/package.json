{
  "name": "@stapel/forms-react",
  "version": "0.2.0",
  "description": "Headless React pair for stapel-forms: typed API client, TanStack Query hooks, LoadState-disciplined headless bags (fill / builder / responses / list / settings), a per-kind field-widget registry over the stapel-attributes vocabulary, client-side validation that mirrors the server's own error keys, the captcha_token seam and the X-Forms-Next-Before CSV export cursor. Zero visual opinion in the main entry; an opt-in /default subpath ships the antd skin over the shared @stapel/tokens-antd/skin substrate (StapelForm, FormBuilderPane, ResponsesPane, FormsListPane, FormSettingsPane) — every field widget and skin slot swappable without a fork.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usestapel/stapel-react.git",
    "directory": "packages/forms-react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./default": {
      "types": "./dist/default/index.d.ts",
      "default": "./dist/default/index.js"
    },
    "./i18n/ru": {
      "types": "./dist/i18n/ru.d.ts",
      "default": "./dist/i18n/ru.js"
    },
    "./i18n/es": {
      "types": "./dist/i18n/es.d.ts",
      "default": "./dist/i18n/es.js"
    },
    "./manifest": "./manifest.json",
    "./manifest.json": "./manifest.json",
    "./nav-manifest.json": "./nav-manifest.json",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "MODULE.md",
    "CHANGELOG.md",
    "manifest.json",
    "nav-manifest.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && vitest run --exclude test/prodBundlePurity.test.ts",
    "lint": "eslint .",
    "size": "size-limit",
    "test:pack": "vitest run test/prodBundlePurity.test.ts"
  },
  "size-limit": [
    {
      "name": "index — headless forms pair (client + hooks + bags + widget registry + i18n)",
      "path": "dist/index.js",
      "limit": "12 KB"
    },
    {
      "name": "default — the antd skin (form renderer, builder, responses) must stay out of the main bundle",
      "path": "dist/default/index.js",
      "limit": "18 KB"
    },
    {
      "name": "i18n/ru — the Russian bundle is opt-in, not carried by the main entry",
      "path": "dist/i18n/ru.js",
      "limit": "5 KB"
    },
    {
      "name": "i18n/es — the Spanish bundle is opt-in, not carried by the main entry",
      "path": "dist/i18n/es.js",
      "limit": "4 KB"
    }
  ],
  "peerDependencies": {
    "@stapel/core": ">=0.18.0 <1.0.0",
    "@stapel/tokens-antd": ">=0.6.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": ">=5.20.0 <7",
    "react": ">=19"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@stapel/core": "workspace:^",
    "@stapel/showcase": "workspace:^",
    "@stapel/tokens": "workspace:^",
    "@stapel/tokens-antd": "workspace:*",
    "@tanstack/react-query": "^5.81.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "antd": "^6.5.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
