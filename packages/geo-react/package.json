{
  "name": "@stapel/geo-react",
  "version": "0.5.0",
  "description": "React pair for stapel-geo: the human half of a location. A picker a product mounts once and gets a map, search-as-you-type, the browser's position prompt and a draggable pin that turns into a real address — instead of two raw fields called latitude and longitude. Headless hooks (map config, debounced+aborted forward search, browser geolocation with its four distinct refusals, pin -> resolve) plus an opt-in /default antd skin whose basemap is drawn here, with no map-library dependency and the OSM attribution it is not allowed to suppress. Anonymous is a supported state: the four geocoding verbs default to authenticated-only, so the map and the pin keep working and only the address is unavailable.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usestapel/stapel-react.git",
    "directory": "packages/geo-react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./default": {
      "types": "./dist/default/index.d.ts",
      "default": "./dist/default/index.js"
    },
    "./i18n/ru": {
      "types": "./dist/i18n/ru.d.ts",
      "default": "./dist/i18n/ru.js"
    },
    "./i18n/es": {
      "types": "./dist/i18n/es.d.ts",
      "default": "./dist/i18n/es.js"
    },
    "./manifest": "./manifest.json",
    "./manifest.json": "./manifest.json",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "MODULE.md",
    "CHANGELOG.md",
    "manifest.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.demo.json && vitest run --exclude test/prodBundlePurity.test.ts",
    "test:pack": "vitest run test/prodBundlePurity.test.ts",
    "lint": "eslint .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "index — the headless pair (client + coords/mercator + the three hooks): no antd, no map library",
      "path": "dist/index.js",
      "limit": "9 KB"
    },
    {
      "name": "default — the antd skin and its own tile renderer must stay out of the main bundle",
      "path": "dist/default/index.js",
      "limit": "12 KB"
    },
    {
      "name": "i18n/ru — the Russian bundle is opt-in, not carried by the main entry",
      "path": "dist/i18n/ru.js",
      "limit": "3.5 KB"
    },
    {
      "name": "i18n/es — the Spanish bundle is opt-in, not carried by the main entry",
      "path": "dist/i18n/es.js",
      "limit": "3.5 KB"
    }
  ],
  "peerDependencies": {
    "@stapel/core": ">=0.20.0 <1.0.0",
    "@stapel/tokens-antd": ">=0.8.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": ">=5.20.0 <7",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@stapel/tokens-antd": {
      "optional": true
    },
    "antd": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@stapel/core": "workspace:^",
    "@stapel/showcase": "workspace:^",
    "@stapel/tokens": "workspace:^",
    "@stapel/tokens-antd": "workspace:^",
    "@tanstack/react-query": "^5.81.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "antd": "^6.5.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
