{
  "name": "@stapel/orders-react",
  "version": "0.2.0",
  "description": "Cart, idempotent checkout and order history for stapel-orders. Zero visual opinion in the main entry; an opt-in /default subpath ships the antd pages and the cart badge.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usestapel/stapel-react.git",
    "directory": "packages/orders-react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./default": {
      "types": "./dist/default/index.d.ts",
      "default": "./dist/default/index.js"
    },
    "./i18n/ru": {
      "types": "./dist/i18n/ru.d.ts",
      "default": "./dist/i18n/ru.js"
    },
    "./i18n/es": {
      "types": "./dist/i18n/es.d.ts",
      "default": "./dist/i18n/es.js"
    },
    "./manifest": "./manifest.json",
    "./manifest.json": "./manifest.json",
    "./nav-manifest.json": "./nav-manifest.json",
    "./flows.json": "./flows.json",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "MODULE.md",
    "CHANGELOG.md",
    "manifest.json",
    "nav-manifest.json",
    "flows.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.demo.json && vitest run --exclude test/prodBundlePurity.test.ts",
    "test:pack": "vitest run test/prodBundlePurity.test.ts",
    "lint": "eslint .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "index — client, cart/checkout/order hooks, headless AddToCartButton, testids; no antd, no skin, no ru/es (4.65 KB measured)",
      "path": "dist/index.js",
      "limit": "6 KB"
    },
    {
      "name": "default — the antd pages (cart, checkout, history, detail), the cart badge and the skinned add-to-cart (6.29 KB measured)",
      "path": "dist/default/index.js",
      "limit": "8 KB"
    },
    {
      "name": "i18n/ru — opt-in locale, not carried by the main entry (2.12 KB measured)",
      "path": "dist/i18n/ru.js",
      "limit": "3 KB"
    },
    {
      "name": "i18n/es — opt-in locale, not carried by the main entry (1.86 KB measured)",
      "path": "dist/i18n/es.js",
      "limit": "3 KB"
    }
  ],
  "peerDependencies": {
    "@stapel/core": ">=0.30.0 <1.0.0",
    "@stapel/tokens-antd": ">=0.22.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": ">=5.20.0 <7",
    "react": ">=19"
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@stapel/core": "workspace:^",
    "@stapel/showcase": "workspace:^",
    "@stapel/tokens": "workspace:^",
    "@stapel/tokens-antd": "workspace:^",
    "@tanstack/react-query": "^5.81.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "antd": "^6.5.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
