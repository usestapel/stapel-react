{
  "name": "@stapel/billing-react",
  "version": "0.8.0",
  "description": "Headless React flow pair for stapel-billing: typed API client, TanStack Query hooks, flow machines, headless components, and i18n keys. Since stapel-billing 0.8.0 a balance is a set of credit lots with expiry dates, so `useWallet` hands out `lots`, `holds` and the server's `expiringSoon` as LoadStates — a failed wallet read can never be drawn as a wallet with no credits, and neither the spend order nor the deadline is recomputed on the client. Zero visual opinion in the main entry; an opt-in /default subpath ships the antd skin: <WalletPanel/> states the balance, when the expiring credits die, and the two ways to buy side by side with the price per credit under both.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/usestapel/stapel-react.git",
    "directory": "packages/billing-react"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./default": {
      "types": "./dist/default/index.d.ts",
      "default": "./dist/default/index.js"
    },
    "./i18n/ru": {
      "types": "./dist/i18n/ru.d.ts",
      "default": "./dist/i18n/ru.js"
    },
    "./i18n/es": {
      "types": "./dist/i18n/es.d.ts",
      "default": "./dist/i18n/es.js"
    },
    "./manifest": "./manifest.json",
    "./manifest.json": "./manifest.json",
    "./llms.txt": "./llms.txt",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "tsconfig.json",
    "README.md",
    "MODULE.md",
    "CHANGELOG.md",
    "manifest.json",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.demo.json && vitest run --exclude test/prodBundlePurity.test.ts",
    "test:pack": "vitest run test/prodBundlePurity.test.ts",
    "lint": "eslint .",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "index — the ru/es locales must NOT be in the main bundle",
      "path": "dist/index.js",
      "limit": "12 KB"
    },
    {
      "name": "default — the antd skin (the wallet panel and the two-column shop) must stay out of the main bundle",
      "path": "dist/default/index.js",
      "limit": "9 KB"
    },
    {
      "name": "i18n/ru subpath (opt-in locale: en floor + generated ru + ru UI)",
      "path": "dist/i18n/ru.js",
      "limit": "3.5 KB"
    },
    {
      "name": "i18n/es subpath (opt-in locale: en floor + generated es errors; no es UI copy yet)",
      "path": "dist/i18n/es.js",
      "limit": "2.5 KB"
    }
  ],
  "peerDependencies": {
    "@stapel/core": ">=0.13.0 <1.0.0",
    "@stapel/tokens-antd": ">=0.5.0",
    "@tanstack/react-query": "^5.0.0",
    "antd": ">=5.20.0 <7",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "@stapel/tokens-antd": {
      "optional": true
    },
    "antd": {
      "optional": true
    }
  },
  "devDependencies": {
    "@size-limit/preset-small-lib": "^11.2.0",
    "@stapel/core": "workspace:^",
    "@stapel/showcase": "workspace:^",
    "@stapel/tokens": "workspace:^",
    "@stapel/tokens-antd": "workspace:^",
    "@tanstack/react-query": "^5.81.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "antd": "^6.5.0",
    "jsdom": "^26.1.0",
    "msw": "^2.10.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "size-limit": "^11.2.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
