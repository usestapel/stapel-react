      "component": "TransactionHistory",
      "variants": [
        "default",
        "empty"
      ],
      "source": "demo/TransactionHistorySkin.demo.tsx"
    },
    {
      "id": "billing.wallet-panel",
      "title": "Billing page (default skin)",
      "description": "The shipped billing screen: the two credit pools stated separately (bought credits that never expire vs plan credits with a deadline — never one sum), any debt with what the next purchase settles, the subscription and its next date, both ways to buy with the price per credit under each, automatic top-up, and the credit ledger.",
      "component": "WalletPanel",
      "covers": [
        "BillingProvider",
        "PricingTable"
      ],
      "variants": [
        "default",
        "in-debt",
        "empty",
        "shop-down"
      ],
      "source": "demo/WalletPanelSkin.demo.tsx"
    },
    {
      "id": "billing.wallet-settings",
      "title": "Automatic top-up (default skin)",
      "description": "The auto-recharge and low-balance settings over PATCH /wallet: a trigger balance, the package bought when it is crossed, and an alert threshold — with both switched-off states explained in words beside the control.",
